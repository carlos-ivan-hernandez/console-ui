{
  "name": "console-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal-style, keyboard-first React components with the vera-console look.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlos-ivan-hernandez/console-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./style.css": "./dist/console-ui.css"
  },
  "scripts": {
    "build": "tsc -b && vite build && tsc -p tsconfig.lib.json && cp src/lib/styles.css dist/console-ui.css",
    "dev": "vite --host",
    "fix": "oxlint --fix && oxfmt write .",
    "lint": "oxlint",
    "preview": "vite preview",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {},
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "codemirror": "^6.0.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@replit/codemirror-vim": {
      "optional": true
    },
    "codemirror": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.6.0"
}
